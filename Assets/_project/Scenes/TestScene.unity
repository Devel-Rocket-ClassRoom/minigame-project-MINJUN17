  closeRecruitWindowButton: {fileID: 1609104662}
  closeHireWindowButton: {fileID: 938832033}
  placementCancelButton: {fileID: 327684195}
  seatData: {fileID: 11400000, guid: 74de6b7a3626ae640897fd30ff46ae6d, type: 2}
  grillData: {fileID: 11400000, guid: d19e3da870805a242a72292d0739cb8f, type: 2}
  eggData: {fileID: 11400000, guid: 0a16036f7b197d040914a8f28a7124e7, type: 2}
  satisfactionGrant: 100000
  tutorialRecruitTier: 0
  steps:
  - line: "\uC548\uB155\uD558\uC138\uC694 \uC0AC\uC7A5\uB2D8! \uBCF8\uC0AC\uC5D0\uC11C
      \uB9E4\uC7A5\uC6B4\uC601\uC744 \uB3C4\uC640\uB4DC\uB9AC\uB824\uACE0 \uB098\uC654\uC2B5\uB2C8\uB2E4"
    target: {fileID: 0}
    advance: 0
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uBA3C\uC800 \uC9C1\uC6D0\uBD80\uD130 \uACE0\uC6A9\uD574\uBCFC\uAC8C\uC694"
    target: {fileID: 0}
    advance: 0
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uBA54\uB274 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 1612942256}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uACE0\uC6A9 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 1484488086}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uC774\uB7F0 \uC544\uC9C1 \uC9C0\uC6D0\uC790\uAC00 \uC5C6\uC5B4\uC694.
      \uBAA8\uC9D1 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uBAA8\uC9D1\uD558\uB7EC\uAC00\uBCFC\uAE4C\uC694?"
    target: {fileID: 621491323}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uC77C\uBC18 \uBAA8\uC9D1 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 2097935672}
    advance: 2
    eventKind: 1
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uB2E4\uC2DC \uBA54\uB274 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 1612942256}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 1
    lowerDialogue: 0
  - line: "\uACE0\uC6A9 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 1484488086}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uC624! \uC9C0\uC6D0\uC790\uAC00 \uB450\uBA85\uC774\uB098 \uC0DD\uACBC\uB124\uC694
      \uC6D0\uB798\uB294 1\uB2EC\uD6C4\uC5D0 \uC0DD\uAE34\uB2F5\uB2C8\uB2E4. \uC694\uB9AC\uC0AC\uC640
      \uC11C\uBC84\uB97C \uAC01\uAC01 \uACE0\uC6A9\uD574\uBCF4\uC138\uC694"
    target: {fileID: 1463457501}
    advance: 2
    eventKind: 2
    eventCount: 2
    onEnter: 0
    lowerDialogue: 0
  - line: "\uB2E4\uC74C\uC740 \uC88C\uC11D\uC744 \uC124\uCE58\uD574\uBD05\uC2DC\uB2E4
      \uBA54\uB274\uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 1612942256}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uC124\uCE58\uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 1086819045}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uC88C\uC11D\uC744 \uB204\uB978 \uD6C4 \uCCB4\uD06C\uBC15\uC2A4\uB97C
      \uD074\uB9AD\uD574\uBCF4\uC138\uC694"
    target: {fileID: 1468319082}
    advance: 2
    eventKind: 3
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uC6D0\uD558\uB294 \uACF3\uC5D0 \uB4DC\uB798\uADF8 \uD6C4 \uC88C\uCE21
      \uD558\uB2E8\uC758 \uC124\uCE58 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC124\uCE58\uD558\uC138\uC694"
    target: {fileID: 1320526273}
    advance: 2
    eventKind: 4
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uB2E4\uC74C\uC740 \uC870\uB9AC\uB3C4\uAD6C\uB97C \uC124\uCE58\uD574\uBCFC\uAC70\uC5D0\uC694
      \uBA54\uB274\uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 1612942256}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uD574\uAE08\uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 125780734}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uAC00\uAD6C\uBC84\uD2BC\uC744 \uB20C\uB7EC \uBCF4\uC138\uC694"
    target: {fileID: 109187088}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uADF8\uB9B4\uC744 \uD574\uAE08\uD574\uBCF4\uC138\uC694"
    target: {fileID: 2097935672}
    advance: 2
    eventKind: 5
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uADF8\uB9B4\uC774 \uD574\uAE08\uB418\uC5C8\uC5B4\uC694 \uC124\uCE58\uB97C
      \uD574\uC57C \uC0AC\uC6A9 \uAC00\uB2A5\uD574\uC694"
    target: {fileID: 0}
    advance: 0
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uBA54\uB274 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 1612942256}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uC124\uCE58\uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 1086819045}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uC8FC\uBC29 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 1169107497}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uADF8\uB9B4 \uBC84\uD2BC\uC744 \uB204\uB978 \uD6C4 \uCCB4\uD06C \uBC84\uD2BC\uC744
      \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 1468319082}
    advance: 2
    eventKind: 3
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uC6D0\uD558\uB294 \uC8FC\uBC29 \uAD6C\uC5ED\uC5D0 \uB4DC\uB798\uADF8
      \uD6C4 \uC88C\uCE21 \uD558\uB2E8\uC5D0 \uC124\uCE58\uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC138"
    target: {fileID: 1320526273}
    advance: 2
    eventKind: 6
    eventCount: 1
    onEnter: 0
    lowerDialogue: 1
  - line: "\uB2E4\uC74C\uC740 \uC694\uB9AC\uB97C \uAC1C\uBC1C\uD574\uBCFC\uAC70\uC5D0\uC694
      \uBA54\uB274\uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 1612942256}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uD574\uAE08 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 125780734}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uC74C\uC2DD \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    target: {fileID: 790976260}
    advance: 1
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uACC4\uB780\uD6C4\uB77C\uC774\uB97C \uD574\uAE08\uD558\uC138\uC694"
    target: {fileID: 2097935672}
    advance: 2
    eventKind: 7
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uC74C\uC2DD\uC744 \uD574\uAE08\uD558\uBA74 \uC0C8\uB85C\uC6B4 \uC190\uB2D8\uC774
      \uB4F1\uC7A5\uD560 \uC218\uB3C4 \uC788\uB2F5\uB2C8\uB2E4"
    target: {fileID: 0}
    advance: 0
    eventKind: 0
    eventCount: 1
    onEnter: 0
    lowerDialogue: 0
  - line: "\uC774\uC81C \uC601\uC5C5 \uC2DC\uC791\uD569\uB2C8\uB2E4! \uD589\uC6B4\uC744
      \uBE4C\uAC8C\uC694"
